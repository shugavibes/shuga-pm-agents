# ─── AI Provider ──────────────────────────────────────────────────────────────
# Set the key for whichever provider you chose in config.mjs → ai.provider
# You only need ONE of these.

ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com
OPENAI_API_KEY=sk-...               # platform.openai.com
GEMINI_API_KEY=AIza...              # aistudio.google.com
KIMI_API_KEY=sk-...                 # platform.moonshot.cn
DEEPSEEK_API_KEY=sk-...             # platform.deepseek.com
GROQ_API_KEY=gsk_...                # console.groq.com
MISTRAL_API_KEY=...                 # console.mistral.ai

# ─── Slack (optional override) ────────────────────────────────────────────────
# Only needed if you're NOT using Cursor IDE with the Slack MCP connected.
# If you are using Cursor, the token is read automatically — leave this blank.
# SLACK_MCP_TOKEN=xoxe.xoxp-...

# ─── Notion ───────────────────────────────────────────────────────────────────
# Path to your local Notion SQLite database.
# Default (macOS): ~/Library/Application Support/Notion/notion.db
# NOTION_DB_PATH=/custom/path/to/notion.db
